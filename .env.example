# ── Captly Server — Umgebungsvariablen ─────────────────────────────────────
# Kopiere diese Datei nach ".env" und trage deine Werte ein. NIEMALS committen.
# Start mit env-Datei:  set -a; . ./.env; set +a; node server.js
#   (oder die Variablen im systemd-Service / Hosting-Panel setzen)

# ── PFLICHT ────────────────────────────────────────────────────────────────
# OpenAI-Key für "Perfect"-Transkription (whisper-1). Ohne diesen startet der Server NICHT.
OPENAI_API_KEY=sk-...

# ── Basis ──────────────────────────────────────────────────────────────────
PORT=8787
# Öffentliche URL der App (für Stripe-Redirects & als CORS-Standard-Origin)
APP_URL=https://captly.deinedomain.ch
# Persistenter Pfad für die SQLite-DB — MUSS auf dauerhaftem Speicher liegen,
# sonst sind Konten/Abos nach jedem Deploy/Neustart weg. NICHT in /tmp.
DB_PATH=/var/lib/captly/captly.db
# Erlaubte CORS-Origins (kommagetrennt). Standard = APP_URL. '*' nur für offene API.
CORS_ORIGINS=https://captly.deinedomain.ch

# ── Login-Mails (Resend) ───────────────────────────────────────────────────
# Ohne RESEND_API_KEY erscheinen Login-Codes nur im Server-Log (= nur für lokale Tests).
# Für echte Nutzer PFLICHT, sonst kommt kein Login-Code an.
RESEND_API_KEY=re_...
MAIL_FROM=login@deinedomain.ch

# ── Stripe (Bezahlung) ─────────────────────────────────────────────────────
# Ohne diese antwortet /billing/checkout sauber mit 501 (kein Kauf möglich).
STRIPE_SECRET=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_CREATOR=price_...   # Creator 9 €/Monat (subscription)
STRIPE_PRICE_PRO=price_...       # Pro 24 €/Monat (subscription)
STRIPE_PRICE_PACK=price_...      # Minuten-Pack 3 € (one-time payment)

# ── Admin & Kostenschutz ───────────────────────────────────────────────────
ADMIN_PASS=langes-geheimes-passwort   # Basic-Auth für /admin (User "admin")
FREE_PER_DAY=3        # anonyme Perfect-Videos pro IP/Tag
MAX_DAY_USD=5         # Tages-Notbremse (API-Spend) → 503
MAX_MONTH_USD=50      # Monats-Notbremse (API-Spend) → 503
ALERT_USD=10          # Alarm-Mail ab diesem Monats-Spend
ALERT_EMAIL=du@deinedomain.ch
