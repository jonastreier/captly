{
  "framework": null,
  "buildCommand": null,
  "redirects": [
    {
      "source": "/de/",
      "destination": "/de",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/captly.html"
    },
    {
      "source": "/de",
      "destination": "/captly.de.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "microphone=(), camera=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/transcribe.js": {
      "maxDuration": 60
    },
    "api/polish.js": {
      "maxDuration": 30
    },
    "api/enhance.js": {
      "maxDuration": 30
    },
    "api/keepalive.js": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "17 6 * * *"
    }
  ]
}
